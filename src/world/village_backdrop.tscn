;; Village backdrop -- non-interactive environment dressing (ivy-3cx, ivy-2or).
;; All pieces in pivot-relative local space (origin = hero pivot ground point, y=0 ground).
;; Repositioned by world.gd to (pivot.x, 0, pivot.z) at runtime.
;;
;; Only the near-garden accents are authored here. Cottages, paths, bushes, grass,
;; flowers, clover, the far treeline and the hill ring are generated in
;; village_backdrop.gd (see VillageBackdrop.COTTAGES for the cottage layout).
;;
;; Silhouette rule: no backdrop geometry overlaps hero silhouette in any canonical camera.
[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://src/world/village_backdrop.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://assets/backdrop/pieces/Bush_Common_Flowers.gltf" id="24_bush_flowers"]
[ext_resource type="PackedScene" path="res://assets/backdrop/pieces/Rock_Medium_1.gltf" id="29_rock"]

[node name="VillageBackdrop" type="Node3D"]
script = ExtResource("1_script")

;; Near garden (r=5-8 m): flowering bushes, scaled to waist height
;; (Bush height 1.58 m x 0.63 = ~1.0 m). Exempt from the 6 m cottage-wall rule.
[node name="Garden_Bush1" parent="." instance=ExtResource("24_bush_flowers")]
transform = Transform3D(0.63, 0, 0, 0, 0.63, 0, 0, 0, 0.63, 6.0, 0, 2.5)

[node name="Garden_Bush2" parent="." instance=ExtResource("24_bush_flowers")]
transform = Transform3D(0.63, 0, 0, 0, 0.63, 0, 0, 0, 0.63, -5.5, 0, 3.0)

[node name="Garden_Rock_A" parent="." instance=ExtResource("29_rock")]
transform = Transform3D(0.5, 0, 0, 0, 0.5, 0, 0, 0, 0.5, 5.5, 0, -5.5)

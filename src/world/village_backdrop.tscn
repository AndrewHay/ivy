[node name="VillageBackdrop" type="Node3D"]
script = ExtResource("1_script")

;; ═══════════════════════════════════════════════════════════════════════════
;; NEAR GARDEN — r=5-8 m from pivot (Director ivy-competition zone)
;; Flowers, clover, rocks, stepping stones. No canopy/plain-green-bush.
;; ═══════════════════════════════════════════════════════════════════════════

;; Near garden — 8 items (budget-trimmed from 22; keeps visual variety on all cameras).
;; Items are intentionally within 7 m of pivot and are exempt from the 5.9 m cottage-wall rule.

;; Stepping stones (two paths, SE and SW)
[node name="Path_A1" parent="." instance=ExtResource("30_rockpath")]
transform = Transform3D(0.7, 0, 0.7, 0, 1, 0, -0.7, 0, 0.7, 5.5, 0, 5.5)

[node name="Path_B1" parent="." instance=ExtResource("30_rockpath")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5.0, 0, 5.0)

;; Flowering bushes (right and left of hero, near zone)
;; Bushes: scaled to waist-height (Bush height 1.58 m × 0.63 = ~1.0 m)
[node name="Garden_Bush1" parent="." instance=ExtResource("24_bush_flowers")]
transform = Transform3D(0.63, 0, 0, 0, 0.63, 0, 0, 0, 0.63, 6.0, 0, 2.5)

[node name="Garden_Bush2" parent="." instance=ExtResource("24_bush_flowers")]

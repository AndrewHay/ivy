[node name="CF_Roof_Cover" parent="." instance=ExtResource("4_roof_tiles")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -16, 3.125, 2)

[node name="CF_Chimney" parent="." instance=ExtResource("6_chimney")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -16.5, 3.125, 2.5)

;; CF fences removed — surface budget freed for roof covers and wagon.

;; ═══════════════════════════════════════════════════════════════════════════
;; COTTAGE G — far background right-of-center (deep backdrop depth)
;; Centre (6, 0, -18), r=18.97 m. Small plaster + round-tile (reads small/far).
;; ═══════════════════════════════════════════════════════════════════════════
;;
;; Footprint x∈[4,8] z∈[-19,-17], 4m wide 2m deep.
;; S face (face at z=-17, rot180deg): tz=-17-0.314=-17.3
;; N face (face at z=-19, rot0deg): tz=-19+0.314=-18.7
;; W face (face at x=4, rot90deg): tx=4+0.314=4.3
;; E face (face at x=8, rot-90deg): tx=8-0.314=7.7
;;
;; Tower hero silhouette check from CamSun at z=8:
;;   Hero x-half ≈5m at z=0, subtends arctan(5/8)=32° from CamSun.
;;   Cottage G at x=6, z=-18: angle from center = arctan(6/(8+18))=arctan(6/26)=13°
;;   13°<32° → behind tower hero from CamSun. That's intentional:
;;   the gable roof peak (~5m) appears directly behind/above the tower roofline for depth.
;;   For the SQUARE hero (apex=3.4m, half-width=3.585m at z=0, arctan(3.585/8)=24°):
;;   Cottage G at x=6 → 13° < 24° → also behind the square hero.
;;   This gives a framed background depth, but the cottage at r=19m will
;;   appear small and read as a background element rather than overlapping.

[node name="CG_S_Wall" parent="." instance=ExtResource("2_wall")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 5, 0, -17.3)

[node name="CG_S_Win" parent="." instance=ExtResource("3_wall_win")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 7, 0, -17.3)

[node name="CG_N_W" parent="." instance=ExtResource("2_wall")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 5, 0, -18.7)

[node name="CG_N_E" parent="." instance=ExtResource("2_wall")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 7, 0, -18.7)

[node name="CG_W" parent="." instance=ExtResource("2_wall")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 4.3, 0, -18)

[node name="CG_E" parent="." instance=ExtResource("2_wall")]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 7.7, 0, -18)

[node name="CG_Roof" parent="." instance=ExtResource("4_roof_tiles")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6, 3.125, -18)

[node name="CG_Chimney" parent="." instance=ExtResource("6_chimney")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6.4, 3.125, -18.4)


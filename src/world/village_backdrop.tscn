;; Individual flowers and clover removed — replaced by GDScript MultiMesh scatter
;; (Flower_3_Group ×16 at r=5-12 m, Clover_1 ×20 at r=5-14 m; see village_backdrop.gd).

;; Rock accent
[node name="Garden_Rock_A" parent="." instance=ExtResource("29_rock")]

;; Village backdrop -- non-interactive environment dressing (ivy-3cx slices 1-3 merged).
;; All pieces in pivot-relative local space (origin = hero pivot ground point, y=0 ground).
;; Repositioned by world.gd to (pivot.x, 0, pivot.z) at runtime.
;;
;; LAYOUT OVERVIEW:
;;   Near garden  (r=5-8 m):  flowers, clover, rocks, RockPath stepping stones
;;   Village ring (r=10-17m): 7 cottages + fences, wagon, crates; all clear hero silhouette
;;   Mid trees    (r=12-18m): CommonTree/Pine (tinted canopy leaf — TODO slice 4)
;;   Treeline     (r=20-26m): Pine + TwistedTree as far horizon filler
;;
;; COTTAGE LAYOUT — 7 cottages, all centres >= 10m from pivot.
;; Silhouette rule: no backdrop geometry overlaps hero silhouette in any canonical camera.
;;   CA (14, 0, -8),  r=16.1m  — CamSun right, CamSil right
;;   CB (-13, 0, -9), r=15.8m  — CamSun left, CamSil left
;;   CC (12, 0,  11), r=16.3m  — CamShade right
;;   CD (-12, 0, 11), r=16.3m  — CamShade left
;;   CE (16, 0, -2),  r=16.1m  — side right, visible from CamSun/CamShade right
;;   CF (-16, 0,  2), r=16.1m  — side left, visible from CamSun/CamShade left
;;   CG (6, 0,  -17), r=18.0m  — far background right (behind hero from CamSun, offset enough to peek beside tower hero)
;;
;; ROTATION CONVENTIONS:
;;   rot0deg   face -Z : Transform3D( 1, 0, 0,  0, 1, 0,  0, 0,  1, tx, ty, tz)
;;   rot180deg face +Z : Transform3D(-1, 0, 0,  0, 1, 0,  0, 0, -1, tx, ty, tz)
;;   rot90deg  face -X : Transform3D( 0, 0,-1,  0, 1, 0,  1, 0,  0, tx, ty, tz)
;;   rot-90deg face +X : Transform3D( 0, 0, 1,  0, 1, 0, -1, 0,  0, tx, ty, tz)
;;
;; Wall piece: X±1m, Y 0-3.125m, exterior face at z=-0.314.
;;   rot90  face -X: tx = face_x + 0.314
;;   rot-90 face +X: tx = face_x - 0.314
;;   rot0   face -Z: tz = face_z + 0.314
;;   rot180 face +Z: tz = face_z - 0.314
;;
;; Chimney (Prop_Chimney): shaft+cap local y[0..3.18]; place at y=3.125 → pokes to 6.3m.
;; Chimney2 (Prop_Chimney2): shaft local y[0..3]; place at y=3.125 → pokes to 6.125m.
;;
;; Balcony_Simple_Straight AABB: local z[0.898..1.104] (projects ~1m outward from wall face).
;; Place at y=1.562 (half-wall height), rot180deg on S face → balcony at wall mid-height.
;;
;; WindowShutters_Wide_Flat_Closed AABB: local y[1.093..2.517], z[0.152..0.288].
;; Placed at same position as window wall (rot180), they mount at the right wall height.
;;
;; RockPath_Round_Wide AABB: x[-1.05..1.06], y[-0.01..0.1], z[-1.05..1.0] — ~2m diameter disk.
;;
[gd_scene load_steps=36 format=3]

[ext_resource type="Script" path="res://src/world/village_backdrop.gd" id="1_script"]

